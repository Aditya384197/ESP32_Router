# Classic ESP32 NAT Router — high-throughput audited profile
# Target: ESP32, 4 MB flash, ESP-IDF 5.1.x
#
# The routing mechanism remains lwIP IPv4 forwarding + NAPT.
# Buffer/window values below follow Espressif's ESP32 Wi-Fi iperf profile.
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Keep packet processing out of flash where supported.
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=y
CONFIG_LWIP_L2_TO_L3_COPY=y

# NAT / forwarding.
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# ESP32 Wi-Fi high-throughput profile.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32

# TCP throughput profile.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# CPU / flash: explicit values for reproducible builds.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# Use the proven custom partition map.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# OTA rollback.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Keep enough headroom for the application task and stable management operations.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=7168

# AP DHCP lease capacity. Actual AP client cap is fixed in the application at 8.
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=8

# Quiet bootloader; application logs remain available for diagnostics.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2
